# Copy this file to  .env  in the PROJECT ROOT (D:\Sahayak_Graph) and fill in your key.
# Save it as UTF-8. Never commit .env to Git.
GEMINI_API_KEY=your-key-here

# ---- everything below is optional; remove the # to change a value ----
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MAX_OUTPUT_TOKENS=8192
# GEMINI_MAX_OUTPUT_TOKENS_CAP=32768
# GEMINI_MAX_RETRIES=5
# GEMINI_TIMEOUT_SECONDS=120
# GEMINI_MIN_SECONDS_BETWEEN_CALLS=0     # set to 5 or 6 on a free-tier key if you see 429 errors
# GEMINI_TEMPERATURE=                    # leave empty to use the model default
# GEMINI_THINKING_LEVEL=                 # minimal | low | medium | high  (leave empty = default)
