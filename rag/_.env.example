# Layer 3 needs NO settings to run. Add any of these lines to the root .env (D:\Sahayak_Graph\.env)
# only if you want to change a default. Save the file as UTF-8.

# --- embedding model ---
# EMBEDDING_BACKEND=sentence-transformers      # or "hashing": keyword fallback, no download (tests/offline only)
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5       # any sentence-transformers model name or a local folder
# EMBEDDING_BATCH_SIZE=16

# --- chunking ---
# CHUNK_STRATEGY=merged                        # "merged" (300-420 token chunks) or "section" (one chunk per section)
# CHUNK_MAX_TOKENS=420                         # must fit the model: bge-small accepts 512 including the header
# CHUNK_OVERLAP_TOKENS=60

# --- advanced ---
# RAG_COLLECTION=sahayak_schemes
# EMBEDDING_QUERY_PREFIX=                      # leave unset: the right prefix for the model is chosen automatically
