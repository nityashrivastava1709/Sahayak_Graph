# Layer 4 needs only GEMINI_API_KEY (already in your .env from Layer 1). Everything below is optional.
# Add lines to the root .env (D:\Sahayak_Graph\.env), saved as UTF-8.

# --- where Layer 3 lives (only if the folder is not found automatically) ---
# LAYER3_DIR=D:\Sahayak_Graph\layer3

# --- Gemini (same settings as Layer 1) ---
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MIN_SECONDS_BETWEEN_CALLS=0      # set to 5-6 on a free-tier key if you see 429 errors
# GEMINI_MAX_RETRIES=5

# --- the reranker ---
# RERANKER_BASE_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2    # any cross-encoder with ONE output score, or a local folder
# RERANKER_MAX_LENGTH=512                 # lower (384) is faster but cuts long chunks
# RERANKER_DEVICE=auto                    # auto | cpu | cuda
# RERANK_TOP_N=20                         # how many first-stage candidates get reranked
# MAX_LATENCY_SECONDS=3.0

# --- training data ---
# QUESTIONS_PER_CHUNK=4
# NEGATIVES_PER_QUERY=7
# HARD_NEGATIVES=4
# VAL_FRACTION=0.15
# TEST_FRACTION=0.15

# --- training ---
# TRAIN_EPOCHS=3
# TRAIN_LR=2e-5
# TRAIN_BATCH_GROUPS=4                    # questions per step
# TRAIN_LOSS=listwise                     # listwise | bce
# TRAIN_PATIENCE=2
